@inject IWebHostEnvironment Env
@{
    // ---- Work out the user's role -------------------------------------
    // Role names are a proposal: Patient, Doctor, ClinicStaff (confirm with teammates).
    string role = "";
    if (User.IsInRole("Patient")) role = "Patient";
    else if (User.IsInRole("Doctor")) role = "Doctor";
    else if (User.IsInRole("ClinicStaff")) role = "ClinicStaff";
    else if (Env.IsDevelopment())
    {
        // TEMP UI PREVIEW: read the role chosen with the developer switcher.
        role = Context.Request.Cookies["previewRole"] ?? "";
    }

    bool showShell = role != "";                       // no role = Login-style page (no sidebar)
    string roleLabel = role == "ClinicStaff" ? "Clinic Staff" : role;
    string displayName = User.Identity?.Name ?? "Preview User";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicSystem</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicSystem.styles.css" asp-append-version="true" />
</head>
<body class="@(showShell ? "app-body" : "auth-body")">

    @if (showShell)
    {
        <div class="app-shell">

            <!-- ===== SIDEBAR ===== -->
            <aside class="sidebar-col">
                <div class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="sidebar" aria-label="Main navigation">
                    <div class="sidebar-brand">
                        <span class="brand-icon"><i class="bi bi-heart-pulse-fill"></i></span>
                        <div>
                            <div class="brand-name">ClinicSystem</div>
                            <div class="brand-sub">Appointments &amp; Patients</div>
                        </div>
                        <button type="button" class="btn-close ms-auto d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close"></button>
                    </div>
                    <div class="offcanvas-body">
                        <nav class="sidebar-nav w-100">
                            <partial name="_Sidebar" model="role" />
                        </nav>
                    </div>
                </div>
            </aside>

            <!-- ===== MAIN AREA ===== -->
            <div class="app-main">
                <header class="topbar">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-outline-primary btn-sm d-lg-none" type="button"
                                data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                            <i class="bi bi-list"></i>
                        </button>
                        <h1 class="topbar-title">@ViewData["Title"]</h1>
                    </div>

                    <div class="dropdown">
                        <button class="user-chip" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="avatar"><i class="bi bi-person-fill"></i></span>
                            <span class="d-none d-sm-block text-start">
                                <span class="user-name">@displayName</span>
                                <span class="user-role">@roleLabel</span>
                            </span>
                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <!-- Logout must be a POST form. The tag helper adds the anti-forgery token for us. -->
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item">
                                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </header>

                <main class="app-content" role="main">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>

                <footer class="app-footer">
                    &copy; 2026 ClinicSystem &middot; Group AJK &middot; University of Cebu - Banilad Campus
                </footer>
            </div>
        </div>
    }
    else
    {
        <main class="auth-wrapper" role="main">
            @RenderBody()
        </main>
    }

    @if (Env.IsDevelopment())
    {
        <!-- TEMP UI PREVIEW: delete this block when real login works -->
        <div class="dev-bar">
            DEV ONLY &mdash; preview as:
            <a asp-controller="Home" asp-action="PreviewRole" asp-route-role="Patient">Patient</a>
            <a asp-controller="Home" asp-action="PreviewRole" asp-route-role="Doctor">Doctor</a>
            <a asp-controller="Home" asp-action="PreviewRole" asp-route-role="ClinicStaff">Staff</a>
            <a asp-controller="Home" asp-action="PreviewRole">None</a>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
